# Database Configuration (Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Redis Configuration (Upstash or Railway Redis)
REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-REDIS-URL]:6379

# MinIO/S3 Configuration (Supabase Storage)
MINIO_ENDPOINT=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
MINIO_ACCESS_KEY=[YOUR-SUPABASE-ANON-KEY]
MINIO_SECRET_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
MINIO_BUCKET=artifacts

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# CORS (for frontend deployment)
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:8080

# Trusted hosts (production: set to your Render domain, no wildcards)
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Storage
USE_MINIO=false
MAX_UPLOAD_SIZE=52428800

# Environment (development | production)
ENVIRONMENT=development

# Supabase Auth (optional; set USE_SUPABASE_AUTH=true to enable)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]
USE_SUPABASE_AUTH=false

# Rate limiting (requests per minute)
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_LOGIN=15/minute
RATE_LIMIT_GENERAL=100/minute